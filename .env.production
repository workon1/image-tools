# Loaded for `next build` / `next start`. Local `next dev` still uses localhost unless you set .env.local.
NEXT_PUBLIC_SITE_URL=https://imagereshaper.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@imagereshaper.com
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_ANALYTICS_PROVIDER=ga4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-G9PFRHTLWW
# Publisher id enables /ads.txt for AdSense site verification.
# Ads themselves stay off until approval, an inline slot id, and ADS_ENABLED=true.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1666138461833732
NEXT_PUBLIC_ADS_ENABLED=false
