# Public site URL used for canonical links, Open Graph, robots.txt, and sitemap.xml.
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production builds use https://imagereshaper.com (see .env.production).
# On Vercel, set NEXT_PUBLIC_SITE_URL=https://imagereshaper.com for Production.

# Optional contact email shown on the Contact page. Leave empty to hide an address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Analytics. Leave disabled unless you have configured a provider.
# The app never sends image contents, filenames, or personal data.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# none | console
NEXT_PUBLIC_ANALYTICS_PROVIDER=none

# Ads are off in the MVP. AdSlot renders nothing until this is true.
NEXT_PUBLIC_ADS_ENABLED=false

# Reserved for a future AdSense publisher id. Do not put secrets here.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Reserved for future premium / API features. Unused in the MVP.
NEXT_PUBLIC_PREMIUM_ENABLED=false
NEXT_PUBLIC_API_ENABLED=false
NEXT_PUBLIC_AFFILIATE_ENABLED=false
